# Official upstream Go core is distributed unchanged with corresponding source.
openai-proxy-kit: statically-linked-binary [usr/lib/openai-proxy-kit/libexec/mihomo]
# UID ownership is checked before delegation; root never reads user file contents.
openai-proxy-kit: non-standard-dir-perm 1777 != 0755 [var/lib/openai-proxy-kit/users/]
# Data template only; the rendered wrapper is explicitly executable.
openai-proxy-kit: script-not-executable [usr/lib/openai-proxy-kit/templates/guard-system-proxy.sh.tmpl]
# Pin the system interpreter and ignore Python user/environment customizations.
openai-proxy-kit: command-with-path-in-maintainer-script /usr/bin/python3 (plain script) [prerm:*]
