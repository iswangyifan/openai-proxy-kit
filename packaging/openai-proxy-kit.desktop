[Desktop Entry]
Type=Application
Name=OpenAI Proxy Kit
GenericName=代理控制台
Comment=Codex / ChatGPT 代理启停、节点与实时日志
Exec=openai-proxy-kit
Icon=openai-proxy-kit
Categories=Network;
Keywords=proxy;clash;mihomo;openai;codex;
